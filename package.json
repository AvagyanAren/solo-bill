{
  "name": "solobill",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "npm run rebuild:native && next dev",
    "dev:fast": "next dev",
    "build": "prisma generate && npx tsx scripts/vercel-prebuild.ts && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "postinstall": "prisma generate && npm rebuild better-sqlite3",
    "rebuild:native": "npm rebuild better-sqlite3"
  },
  "engines": {
    "node": ">=20.0.0 <25.0.0"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@libsql/client": "^0.17.3",
    "@prisma/adapter-better-sqlite3": "^7.7.0",
    "@prisma/adapter-libsql": "^7.8.0",
    "@prisma/client": "^7.7.0",
    "@react-stately/utils": "^3.12.1",
    "@tailwindcss/typography": "^0.5.20",
    "@untitledui/icons": "^0.0.22",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.9.0",
    "clsx": "^2.1.1",
    "input-otp": "^1.4.2",
    "jose": "^6.2.2",
    "next": "16.2.4",
    "next-themes": "^0.4.6",
    "openai": "^6.34.0",
    "pdfkit": "^0.19.1",
    "react": "19.2.4",
    "react-aria": "^3.51.0",
    "react-aria-components": "^1.20.0",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.73.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss-animate": "^1.0.7",
    "tailwindcss-react-aria-components": "^2.2.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20",
    "@types/pdfkit": "^0.17.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "postcss": "^8.5.26",
    "prisma": "^7.7.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
